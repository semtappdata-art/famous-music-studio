{
  "version": "1.0",
  "backends": {
    "environment": {
      "prefix": "FMS_",
      "required": [
        "YOUTUBE_API_KEY",
        "SPOTIFY_CLIENT_ID"
      ]
    },
    "vault": {
      "url": "http://localhost:8200",
      "path": "secret/data/fms"
    },
    "aws": {
      "region": "us-east-1",
      "table": "fms-secrets"
    },
    "file": {
      "path": "./.secrets",
      "encrypt": true
    }
  },
  "rotation": {
    "enabled": true,
    "interval_days": 90,
    "warning_days": 7
  },
  "audit": {
    "enabled": true,
    "log_file": "audit_secrets.log",
    "retain_days": 365
  }
}