# .env.example - Tum API anahtarlari
# Bu dosya ornek - .env'de gercek degerler yazilacak

# LLM Provider
OPENROUTER_API_KEY=your-openrouter-key

# Suno
SUNO_API_KEY=your-suno-key

# YouTube
YOUTUBE_API_KEY=your-youtube-key
YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret

# TikTok
TIKTOK_API_KEY=your-tiktok-key
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Instagram
INSTAGRAM_API_KEY=your-instagram-key
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Sentry
SENTRY_DSN=your-sentry-dsn

# VPS
VPS_HOST=your-vps-host
VPS_USER=your-vps-user
VPS_SSH_KEY=/path/to/ssh/key

# Grafana
GRAFANA_PASSWORD=your-grafana-password

# Ntfy
NTFY_TOPIC=your-ntfy-topic

# Database
DATABASE_URL=sqlite:///famous_studio.db

GROQ_API_KEY=your-groq-key
GOOGLE_API_KEY=your-google-key
